{
  "name": "SerenityDev",
  "displayName": "Serenity Dev",
  "description": "Local Python Agent interface running on llama.cpp with llama-server backend.",
  "version": "1.5.0",
  "publisher": "GhostHeartZer0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhostHeartZer0/SerenityDev.git"
  },
  "icon": "serenity_icon.png",
  "engines": {
    "vscode": "^1.107.0",
    "Antigravity IDE": "^2.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "serenitydev.assistant",
        "name": "serenity",
        "description": "SerenityDev Agent Core",
        "commands": [
          {
            "name": "explore",
            "description": "Read-only exploration of the codebase to understand the query"
          },
          {
            "name": "plan",
            "description": "Formulate a detailed execution plan without changing files"
          },
          {
            "name": "execute",
            "description": "Modify files and apply code updates based on the prompt"
          },
          {
            "name": "agent",
            "description": "Autonomous multi-agent execution on an as-needed basis"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "serenitydev",
        "displayName": "SerenityDev"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serenity-explorer",
          "title": "SerenityDev Agent",
          "icon": "$(outline-disclosure)"
        }
      ]
    },
    "views": {
      "serenity-explorer": [
        {
          "type": "webview",
          "id": "serenity.chatView",
          "name": "Planning & Orchestration Library",
          "icon": "$(comment)"
        }
      ]
    },
    "commands": [
      {
        "command": "serenity.showMenu",
        "title": "Serenity: Open Server Status Control Panel"
      }
    ],
    "configuration": {
      "title": "Serenity Dev",
      "properties": {
        "serenitydev.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the Python interpreter used to run the Serenity server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/mocha": "^12.0.0-beta-3",
    "@types/node": "22.x",
