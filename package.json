{
  "name": "SerenityDev",
  "displayName": "Serenity Dev",
  "description": "Local Python Agent interface running on llama.cpp with Ollama backend.",
  "version": "0.0.1",
  "publisher": "GhostHeartZer0",
  "icon": "serenity_icon.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "serenitydev.assistant",
        "name": "serenity",
        "description": "SerenityDev Agent Core"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "serenitydev",
        "displayName": "SerenityDev Local Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serenity-explorer",
          "title": "SerenityDev Agent",
          "icon": "$(outline-disclosure)"
        }
      ]
    },
    "views": {
      "serenity-explorer": [
        {
          "type": "webview",
          "id": "serenity.chatView",
          "name": "Planning & Orchestration Library",
          "icon": "$(comment)"
        }
      ]
    },
    "commands": [
      {
        "command": "serenity.showMenu",
        "title": "Serenity: Open Server Status Control Panel"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
